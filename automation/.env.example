# Configure as GitHub Actions Secrets; never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=
PUBLISH_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLISH_SUPABASE_KEY=
PUBLISH_MEDIA_BUCKET=stoxra-media
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Explicitly select a supported Meta Graph version for your app, e.g. v24.0.
META_API_VERSION=
# ISO-8601 UTC expiry from the official token exchange, not an invented date.
INSTAGRAM_TOKEN_EXPIRES_AT=
# Repository variables. Safe defaults:
ENABLE_LIVE=false
REQUIRE_APPROVAL=true
EDITORIAL_BASELINE_APPROVED=false
